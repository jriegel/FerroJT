"""Type stubs for the compiled FerroJT extension module."""

from __future__ import annotations

from collections.abc import Iterator

__version__: str


class Model:
    """A loaded scene: nodes, meshes, materials and their data."""

    @property
    def node_count(self) -> int: ...
    @property
    def mesh_count(self) -> int: ...
    @property
    def material_count(self) -> int: ...
    @property
    def vertex_count(self) -> int: ...
    @property
    def triangle_count(self) -> int: ...

    def node_names(self) -> list[str]: ...
    def to_bytes(self, format: str) -> bytes: ...
    def save(self, path: str, format: str | None = None) -> None: ...
    def to_json(self) -> str: ...


def open(
    path: str,
    *,
    layer_filter: str | None = ...,
    all_layers: bool = ...,
) -> Model:
    """Read a CAD file into a :class:`Model`.

    *layer_filter* selects one of the named layer filters the file declares.
    Leaving it out applies the filter the file marks as active, which drops the
    meshes of every part that is not on one of its layers. *all_layers* keeps
    every part and ignores the filters of the file.
    """


def detect_format(path: str) -> str: ...


class JtFile:
    """Object representing an open JT file.

    Constructed with a path; nothing is read until :meth:`open` is called.
    """

    def __init__(self, file_name: str) -> None: ...

    #: The path of the JT file, the name the original C++ extension uses.
    FileName: str
    #: Snake case alias of :attr:`FileName`.
    file_name: str

    @property
    def is_open(self) -> bool: ...

    def open(self) -> bool: ...
    @property
    def lsg(self) -> JtLsg | None: ...
    def root(self) -> JtNode | None: ...
    def meshes(self) -> list[JtMesh]: ...
    def json(self) -> str: ...
    def toc(self) -> str: ...
    def writeGlTf(
        self,
        path: str,
        *,
        layer_filter: str | None = ...,
        all_layers: bool = ...,
    ) -> bool: ...
    def write_gltf(
        self,
        path: str,
        *,
        layer_filter: str | None = ...,
        all_layers: bool = ...,
    ) -> bool: ...
    def model(
        self, *, layer_filter: str | None = ..., all_layers: bool = ...
    ) -> Model: ...
    def layer_filters(self) -> list[str]: ...
    def active_layer_filter(self) -> str | None: ...


class JtLsg:
    """The logical scene graph of one open JT file.

    The parsed file lives here, so every :class:`JtNode`, :class:`JtMesh` and
    :class:`JtArray` of the file keeps this object alive: a handle stays valid
    on its own, and the arrays of a :class:`JtMesh` can be handed to NumPy
    without a copy.
    """

    @property
    def path(self) -> str: ...
    @property
    def node_count(self) -> int: ...
    @property
    def representation_count(self) -> int: ...

    def root(self) -> JtNode | None: ...
    def nodes(self) -> list[JtNode]: ...
    def meshes(self) -> list[JtMesh]: ...
    def mesh(self, id: int) -> JtMesh: ...


class JtNode:
    """One node of the logical scene graph.

    A handle is a position in the graph of its file, so it stays valid as long
    as the file object it came from is open, and two handles pointing at the
    same node compare equal. Iterating a node or indexing it yields its direct
    children; a child reference that does not resolve to a node is ``None``.
    """

    @property
    def class_name(self) -> str: ...
    @property
    def id(self) -> int | None: ...
    @property
    def position(self) -> int: ...
    @property
    def name(self) -> str: ...
    @property
    def version(self) -> int: ...
    @property
    def flags(self) -> int: ...
    @property
    def is_tri_strip_set(self) -> bool: ...
    @property
    def is_instance(self) -> bool: ...
    @property
    def mesh_ids(self) -> list[int]: ...
    @property
    def layers(self) -> list[int]: ...
    @property
    def attribute_names(self) -> list[str]: ...
    @property
    def matrix(self) -> list[float] | None: ...
    @property
    def transform(self) -> dict[str, object] | None: ...
    @property
    def translation(self) -> tuple[float, float, float] | None: ...
    @property
    def rotation(self) -> tuple[float, float, float, float] | None: ...
    @property
    def scale(self) -> tuple[float, float, float] | None: ...
    @property
    def bounds(self) -> tuple[float, ...] | None: ...
    @property
    def area(self) -> float | None: ...
    @property
    def lod_limits(self) -> list[float] | None: ...
    @property
    def lod_signal(self) -> float | None: ...
    @property
    def lod_center(self) -> tuple[float, float, float] | None: ...
    @property
    def up_axis(self) -> int | None: ...
    @property
    def partition_file_name(self) -> str | None: ...

    def child_count(self) -> int: ...
    def children(self) -> list[JtNode]: ...
    def unresolved_children(self) -> int: ...
    def instance_target(self) -> JtNode | None: ...
    def descendants(self) -> list[JtNode]: ...
    def subtree_mesh_ids(self) -> list[int]: ...
    def meshes(self) -> list[JtMesh]: ...
    def subtree_meshes(self) -> list[JtMesh]: ...
    def properties(self) -> dict[str, str]: ...
    def material(self) -> dict[str, object] | None: ...
    def late_loads(self) -> list[tuple[int, str, int, str, int]]: ...

    def __len__(self) -> int: ...
    def __getitem__(self, index: int) -> JtNode | None: ...
    def __iter__(self) -> Iterator[JtNode | None]: ...
    def __eq__(self, other: object) -> bool: ...
    def __hash__(self) -> int: ...


class JtMesh:
    """One representation of a JT file: the geometry a shape node late-loads.

    The id is the position of the representation in the file, so every handle
    for the same representation has the same id and the geometry of an
    instantiated part is loaded exactly once.
    """

    @property
    def id(self) -> int: ...
    @property
    def name(self) -> str: ...
    @property
    def element_class(self) -> str | None: ...
    @property
    def segment(self) -> str | None: ...
    @property
    def segment_type(self) -> int | None: ...
    @property
    def segment_type_name(self) -> str | None: ...
    @property
    def index_count(self) -> int: ...
    @property
    def vertex_count(self) -> int: ...
    @property
    def normal_count(self) -> int: ...
    @property
    def triangle_count(self) -> int: ...
    @property
    def is_empty(self) -> bool: ...
    @property
    def normal_binding(self) -> int | None: ...
    @property
    def array_names(self) -> list[str]: ...

    def array(self, name: str) -> JtArray: ...
    def arrays(self) -> dict[str, JtArray]: ...

    def __eq__(self, other: object) -> bool: ...
    def __hash__(self) -> int: ...


class JtArray:
    """One array of a representation, exposed through the buffer protocol.

    ``memoryview`` and ``numpy.asarray`` wrap it **without a copy**: the view
    points straight at the decoded buffers of the file and keeps this object
    alive, which in turn keeps the file alive. The view is read-only, because
    the arrays of a JT file are what the file says they are.
    """

    @property
    def name(self) -> str: ...
    @property
    def mesh_id(self) -> int: ...
    @property
    def ndim(self) -> int: ...
    @property
    def shape(self) -> list[int]: ...
    @property
    def itemsize(self) -> int: ...
    @property
    def format(self) -> str: ...

    def __len__(self) -> int:
        """Number of rows: indices for the index channel, points for the others."""
