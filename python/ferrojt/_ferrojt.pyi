class NodeHandle:
    """A node of a graph under construction.

    A handle is a token: it names one node of one :class:`JtBuilder`, and every
    operation on it goes back through that builder. A handle from another
    builder is rejected.
    """

    @property
    def index(self) -> int: ...
    @property
    def class_name(self) -> str | None: ...
    @property
    def name(self) -> str | None: ...

    def children(self) -> list[NodeHandle]: ...
    def instance_target(self) -> NodeHandle | None: ...

    def __eq__(self, other: object) -> bool: ...
    def __hash__(self) -> int: ...


class MeshHandle:
    """A mesh of a graph under construction."""

    @property
    def index(self) -> int: ...
    @property
    def vertex_count(self) -> int: ...
    @property
    def triangle_count(self) -> int: ...

    def __eq__(self, other: object) -> bool: ...
    def __hash__(self) -> int: ...


class JtBuilder:
    """A new JT file: an empty scene graph that can be filled and written.

    The graph starts as a root ``Partition``; add nodes with :meth:`add_node`,
    shapes with :meth:`add_shape`, and share a subtree with
    :meth:`instance_of`. :meth:`save` writes the file at the revision of
    :attr:`version`, which is JT 10.3 until it is changed.
    """

    def __init__(self) -> None: ...

    @property
    def node_count(self) -> int: ...
    @property
    def mesh_count(self) -> int: ...
    @property
    def compress(self) -> bool: ...
    @compress.setter
    def compress(self, value: bool) -> None: ...
    @property
    def version(self) -> str:
        """The JT revision the file is written at, as ``"major.minor"``."""
    @version.setter
    def version(self, value: str) -> None: ...
    def set_version(self, value: str) -> None:
        """Write the file at revision `value`: ``"8.0"``, ``"8.1"``, ``"9.5"``
        or ``"10.3"``, or a bare major for the default minor of that revision.

        A mesh of a 9.x or 10.x file has to be a closed two-manifold, since
        that is the only thing the topologically compressed coder accepts; a
        mesh that is not can still be written as 8.x.
        """

    def root(self) -> NodeHandle: ...
    def add_node(
        self, parent: NodeHandle, class_name: str, name: str | None = ...
    ) -> NodeHandle: ...
    def add_shape(
        self, parent: NodeHandle, mesh: MeshData, *, name: str | None = ...
    ) -> NodeHandle: ...
    def instance_of(self, parent: NodeHandle, target: NodeHandle) -> NodeHandle: ...
    def add_mesh(self, mesh: MeshData) -> MeshHandle: ...
    def set_mesh(self, node: NodeHandle, mesh: MeshHandle) -> None: ...
    def set_transform(self, node: NodeHandle, matrix: list[float]) -> None:
        """Set the transform matrix, column major, 16 values.

        Element (row, column) is at index ``4 * column + row`` and the
        translation is the last column, which is how JT stores a matrix.
        """
    def set_translation(self, node: NodeHandle, translation: list[float]) -> None: ...
    def set_placement(
        self,
        node: NodeHandle,
        translation: list[float],
        rotation: list[float],
        scale: list[float],
    ) -> None:
        """Set a translation, a rotation quaternion ``(x, y, z, w)`` and a scale."""
    def set_material(self, node: NodeHandle, material: MaterialData) -> None: ...
    def set_name(self, node: NodeHandle, name: str) -> None: ...
    def children(self, node: NodeHandle) -> list[NodeHandle]: ...
    def class_of(self, node: NodeHandle) -> str | None: ...
    def name(self, node: NodeHandle) -> str | None: ...
    def instance_target(self, node: NodeHandle) -> NodeHandle | None: ...
    def to_bytes(self) -> bytes: ...
    def save(self, path: str) -> None: ...

